<h1>注文履歴</h1>

<% if @orders.empty? %>
  <p>注文はまだありません</p>
<% else %>
  <ul>
    <% @orders.each do |order| %>
      <li>
        <%= link_to "注文 ##{order.id}", order_path(order) %>
        - <%= order.status_label %>
        - ¥<%= order.total_cents / 100 %>
        - <%= order.created_at.strftime("%Y/%m/%d") %>
      </li>
    <% end %>
  </ul>
<% end %>

<p><%= link_to "商品一覧に戻る", products_path %></p>
