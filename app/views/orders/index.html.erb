<h1>注文履歴</h1>

<% if @orders.empty? %>
  <p>注文はまだありません</p>
<% else %>
  <ul>
    <% @orders.each do |order| %>
      <% order = order.decorate %>
      <li>
        <%= link_to "注文 ##{order.id}", order_path(order) %>
        - <%= order.status_label%>
        - <%= order.total.formatted %>
        - <%= order.created_at_formatted %>
      </li>
    <% end %>
  </ul>
<% end %>

<p><%= link_to "商品一覧に戻る", products_path %></p>
