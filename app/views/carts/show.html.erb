<h1>カート</h1>

<% if @cart.cart_items.empty? %>
  <p>カートは空です</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>商品</th>
        <th>単価</th>
        <th>数量</th>
        <th>小計</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @cart.cart_items.includes(:product).each do |item| %>
        <tr>
          <td><%= item.product.name %></td>
          <%# 伏線: ここでも価格表示が散在 %>
          <td>¥<%= item.product.price_cents / 100 %></td>
          <td>
            <%= form_with url: cart_item_path(item), method: :patch, local: true do |f| %>
              <%= f.number_field :quantity, value: item.quantity, min: 1, max: item.product.stock %>
              <%= f.submit "更新" %>
            <% end %>
          </td>
          <td>¥<%= item.subtotal_cents / 100 %></td>
          <td>
            <%= button_to "削除", cart_item_path(item), method: :delete %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="3">合計数量: <%= @cart.total_quantity %></td>
        <td colspan="2">合計金額: ¥<%= @cart.total_cents / 100 %></td>
      </tr>
    </tfoot>
  </table>

  <%# 注文確定ボタンは Step 5 で実装 %>
  <% if Current.user.address %>
    <%= button_to "注文を確定する", orders_path, method: :post %>
    <p>配送先: <%= Current.user.address.full_address %> (<%= link_to "変更", edit_address_path %>)</p>
  <% else %>
    <p><%= link_to "配送先を登録して注文に進む", new_address_path %></p>
  <% end %>
<% end %>

<p><%= link_to "商品一覧に戻る", products_path %></p>
